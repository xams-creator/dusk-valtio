{
    "name": "@xams-framework/dusk-valtio",
    "version": "0.1.2",
    "type": "module",
    "scripts": {
        "dev": "vite --force",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "format": "prettier --write --experimental-cli ./",
        "format:check": "prettier --check ."
    },
    "homepage": "https://github.com/xams-creator/dusk-valtio",
    "author": {
        "name": "xams-creator",
        "email": "1228552328@qq.com",
        "url": "https://github.com/xams-creator"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18",
        "lodash": ">=4"
    },
    "files": [
        "dist"
    ],
    "main": "./dist/dusk-valtio.js",
    "module": "./dist/dusk-valtio.js",
    "types": "./dist/index.d.ts",
    "dependencies": {
        "valtio": "^2.3.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.3.0",
        "@commitlint/config-conventional": "^19.2.2",
        "@eslint/js": "^9.39.4",
        "@rolldown/plugin-babel": "^0.2.2",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^24.12.0",
        "@types/lodash": "^4.17.24",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.57.0",
        "vite": "^8.0.1",
        "vite-plugin-dts": "^4.5.4",
        "yorkie": "^2.0.0"
    },
    "gitHooks": {
        "commit-msg": "commitlint -e -V",
        "pre-commit": "lint-staged"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ],
        "rules": {
            "type-enum": [
                2,
                "always",
                [
                    "init",
                    "build",
                    "ci",
                    "chore",
                    "docs",
                    "feat",
                    "fix",
                    "perf",
                    "refactor",
                    "revert",
                    "style",
                    "test",
                    "deps",
                    "upgrade"
                ]
            ]
        }
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
            "prettier --write"
        ]
    },
    "prettier": {
        "semi": true,
        "singleQuote": true,
        "tabWidth": 4,
        "printWidth": 120,
        "useTabs": false,
        "jsxSingleQuote": false,
        "bracketSpacing": true,
        "htmlWhitespaceSensitivity": "css",
        "arrowParens": "avoid",
        "endOfLine": "crlf",
        "trailingComma": "es5",
        "plugins": [
            "@trivago/prettier-plugin-sort-imports"
        ],
        "importOrder": [
            "^react(.*)$",
            "<THIRD_PARTY_MODULES>",
            "^@/(.*)$",
            "^src/(.*)$",
            "^[./]"
        ],
        "importOrderSeparation": true,
        "importOrderSortSpecifiers": true,
        "importOrderParserPlugins1": [
            "typescript",
            "jsx",
            "decorators"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}

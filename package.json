{
    "private": true,
    "workspaces": [
        "packages/*",
        "examples/*"
    ],
    "scripts": {
        "dev:dv": "npm run dev --workspace=packages/dusk-valtio",
        "build:dv": "npm run build --workspace=packages/dusk-valtio",
        "lint:dv": "npm run lint --workspace=packages/dusk-valtio",
        "preview:dv": "npm run preview --workspace=packages/dusk-valtio",
        "format:dv": "npm run format --workspace=packages/dusk-valtio",
        "format:check:dv": "npm run format:check --workspace=packages/dusk-valtio",
        "test:dv": "npm run test --workspace=packages/dusk-valtio",

        "dev:example": "npm run dev --workspace examples/example"
    }
}
